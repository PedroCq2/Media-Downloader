+	private static final JSONCollection findContentData(JSONCollection data, int depth) {
+		if(data == null || depth > 8) {
+			return null;
+		}
+		
+		JSONCollection candidate = data.getCollection("contentData");
+		if(candidate != null && candidate.hasString("title")) {
+			return candidate;
+		}
+		
+		for(JSONCollection child : data.collectionsIterable()) {
+			JSONCollection found = findContentData(child, depth + 1);
+			
+			if(found != null) {
+				return found;
+			}
+		}
+		
+		return null;
+	}
