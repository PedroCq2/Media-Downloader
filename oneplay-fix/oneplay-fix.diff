+	// Writes only the key paths (no values, no tokens) of the content.play response
+	// to the temporary directory, so that the new structure can be inspected.
+	private static final void dumpResponseStructure(JSONCollection data) {
+		try {
+			StringBuilder builder = new StringBuilder();
+			dumpKeys(data, "", builder, 0);
+			java.nio.file.Path path = java.nio.file.Path.of(
+				System.getProperty("java.io.tmpdir"), "oneplay-content-play-keys.txt"
+			);
+			java.nio.file.Files.writeString(path, builder.toString());
+		} catch(Exception ex) {
+			// Ignore, diagnostics only
+		}
+	}
+	
+	private static final void dumpKeys(JSONCollection data, String prefix, StringBuilder builder, int depth) {
+		if(depth > 12) return;
+		
+		for(JSONNode node : data.nodesIterable()) {
+			String path = prefix.isEmpty() ? node.name() : prefix + "." + node.name();
+			
+			if(node.isCollection()) {
+				builder.append(path).append('\n');
+				dumpKeys((JSONCollection) node, path, builder, depth + 1);
+			} else {
+				builder.append(path).append(" : ").append(((JSONObject) node).type()).append('\n');
+			}
+		}
 	}
 	
