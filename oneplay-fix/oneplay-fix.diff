+	private static final String titleFromUri(URI uri) {
+		String path = uri.getPath();
+		
+		if(path != null) {
+			String[] parts = path.split("/");
+			
+			for(int i = parts.length - 1; i >= 0; --i) {
+				if(!parts[i].isBlank()) {
+					return parts[i];
+				}
+			}
+		}
+		
+		return "oneplay";
+	}
